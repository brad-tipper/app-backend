{
  "name": "bradtipper/app-backend",
  "description": "Shared Silverstripe 6 headless API foundations (auth, sync helpers, OpenAPI) for the app fleet.",
  "type": "silverstripe-vendormodule",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "silverstripe/framework": "^6.0",
    "symbiote/silverstripe-queuedjobs": "^6",
    "phptek/sentry": "^6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3"
  },
  "autoload": {
    "psr-4": {
      "BradTipper\\AppBackend\\": "src/",
      "BradTipper\\AppBackend\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
